{
  "name": "semdom-org",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:xml && astro build && pagefind --site dist --output-path dist/pagefind",
    "preview": "astro preview",
    "build:xml": "node scripts/build-xml.mjs",
    "verify": "node scripts/build-xml.mjs --out .verify --verify",
    "check:emit": "node scripts/check-emit.mjs",
    "materialize": "node scripts/materialize.mjs"
  },
  "dependencies": {
    "astro": "^5.1.1",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "fast-xml-parser": "^4.5.1"
  }
}
