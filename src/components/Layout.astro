---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines — used by the unpublished /v5/ draft. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Build the main navigation from content pages flagged showInMenu, plus the
// "Browse Domains" section (a route, not a content page). Everything is sorted
// by menuOrder so editors can reorder from the CMS.
type NavItem = { href: string; label: string; order: number };

const pageItems: NavItem[] = (await getCollection('pages'))
  .filter((p) => p.data.showInMenu)
  .map((p) => ({
    href: withBase(p.id === 'home' ? '/' : `/${p.id}/`),
    label: p.data.menuTitle ?? p.data.title,
    order: p.data.menuOrder ?? 99,
  }));

// The /v5/ draft is deliberately absent here: it is deployed live but unlinked
// so reviewers can reach it by direct URL without it looking published. Add an
// entry back when v5 is promoted.
const navItems: NavItem[] = [
  ...pageItems,
  { href: withBase('/v4/'), label: 'Browse Domains', order: 2 },
].sort((a, b) => a.order - b.order);

// Normalise paths (strip trailing slashes) so active-state comparison is
// robust regardless of the base path or trailing-slash config.
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = norm(Astro.url.pathname);
const homePath = norm(withBase('/'));
const isActive = (href: string) => {
  const target = norm(href);
  if (target === homePath) return currentPath === homePath;
  return currentPath === target || currentPath.startsWith(target + '/');
};

const pagefindBase = withBase('/pagefind');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Semantic Domains</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="stylesheet" href={`${pagefindBase}/pagefind-ui.css`} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={withBase('/')}>
          <img class="site-logo" src={withBase('/sil-logo.webp')} alt="SIL Global" width="63" height="34" />
          <span class="site-title">Semantic Domains<small>SIL Global</small></span>
        </a>
        <nav aria-label="Main">
          <ul class="site-nav">
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div id="search" class="site-search"></div>
      </div>
    </header>

    <div class:list={['page-shell', { 'with-sidebar': Astro.slots.has('sidebar') }]}>
      <slot />
      <slot name="sidebar" />
    </div>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <a href="https://www.sil.org" aria-label="SIL Global">
          <img class="footer-logo" src={withBase('/sil-logo-white.png')} alt="SIL Global" width="63" height="34" />
        </a>
        <div class="site-footer-text">
          The content on this website by SIL Global is licensed under a
          <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">Creative Commons Attribution-ShareAlike 4.0 International License</a>.
        </div>
      </div>
    </footer>

    <script define:vars={{ pagefindBase }}>
      import(`${pagefindBase}/pagefind-ui.js`)
        .then(() => {
          // eslint-disable-next-line no-undef
          new PagefindUI({ element: '#search', bundlePath: `${pagefindBase}/`, showSubResults: true, showImages: false });
        })
        .catch(() => {
          /* search index not built yet (e.g. dev mode before first build) */
        });
    </script>
  </body>
</html>
