---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import PageSequenceNav from '../../components/PageSequenceNav.astro';
import SectionLink from '../../components/SectionLink.astro';

export async function getStaticPaths() {
  // Every page with a dedicated route under src/pages must be excluded here or the
  // build fails on a duplicate route: 'home' lives at /, 'bibliography' also renders the
  // data downloads, 'contact' appends the form, 'about' appends its section cards, and
  // 'louw-nida' / 'ocm' each append a generated cross-reference table.
  const excluded = new Set(['home', 'bibliography', 'contact', 'about', 'louw-nida', 'ocm']);
  const pages = await getCollection('pages');
  return pages
    .filter((p) => !excluded.has(p.id))
    .map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary} section={entry.data.section}>
  <div class="content-page" data-pagefind-body>
    {entry.data.section && <SectionLink section={entry.data.section} />}
    <h1>{entry.data.title}</h1>
    <Content />
    <PageSequenceNav current={entry.id} />
  </div>
</Layout>
