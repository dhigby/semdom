---
import { getEntry, render } from 'astro:content';
import Layout from '../components/Layout.astro';
import PageSequenceNav from '../components/PageSequenceNav.astro';

const entry = await getEntry('pages', 'home');
const { Content } = await render(entry!);
---

<Layout title={entry!.data.title} description={entry!.data.summary}>
  <div class="content-page" data-pagefind-body>
    <h1>{entry!.data.title}</h1>
    <Content />
    <PageSequenceNav current="home" />
  </div>
</Layout>
